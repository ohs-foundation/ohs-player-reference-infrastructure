# Host nginx — per-subdomain front for the OHS Player stack.
# Copy into your host nginx (e.g. /etc/nginx/sites-available/) and reload.
# One subdomain per service, routed by server_name to the published container port.
#
# DNS: all three names must resolve (publicly) to this server's external IP.
# Containers reach Keycloak via docker-compose.server.yml extra_hosts (KEYCLOAK_ISSUER_HOST).
#
# .env values that match this file:
#   KEYCLOAK_ISSUER_HOST=keycloak-ohs-player.nawi.ke
#   KEYCLOAK_PUBLIC_URL=http://keycloak-ohs-player.nawi.ke
#   OHS_PLAYER_APP_HOST=web-ohs-player.nawi.ke
#   VITE_FHIR_BASE_URL=http://gateway-ohs-player.nawi.ke/fhir
#
# TLS: these are HTTP (port 80). For production add 443 server blocks with certs
# (e.g. certbot --nginx) and switch the http:// values above to https://.

# --- Keycloak ---------------------------------------------------------------
server {
    listen 80;
    server_name keycloak-ohs-player.nawi.ke;

    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
    }
}

# --- Web SPA ----------------------------------------------------------------
server {
    listen 80;
    server_name web-ohs-player.nawi.ke;

    location / {
        proxy_pass http://127.0.0.1:8084;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# --- FHIR gateway -----------------------------------------------------------
server {
    listen 80;
    server_name gateway-ohs-player.nawi.ke;

    # /fhir/* : the gateway's own CORS interceptor already sends
    # Access-Control-Allow-Origin (so DO NOT add CORS here — it would duplicate).
    location /fhir/ {
        proxy_pass http://127.0.0.1:8083;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # /api/* : the plugin's servlets have NO CORS, so add it here for the SPA
    # origin and answer preflight (OPTIONS) at the edge.
    location /api/ {
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin  $http_origin always;
            add_header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Authorization, Content-Type, Accept" always;
            add_header Access-Control-Max-Age       3600 always;
            add_header Content-Length 0;
            add_header Content-Type   text/plain;
            return 204;
        }
        proxy_pass http://127.0.0.1:8083;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Access-Control-Allow-Origin $http_origin always;
    }

    location / {
        proxy_pass http://127.0.0.1:8083;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
