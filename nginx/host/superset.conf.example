# Host nginx vhost for the Superset dashboard.
#
# Generated by `./dev.sh render` from this template, so change SUPERSET_HOST or SUPERSET_PORT in
# .env and re-render rather than editing the output. Rendered only when SUPERSET_HOST is set,
# because Superset belongs to the --pipes profile and most stacks never run it.
#
# `./dev.sh nginx` installs this and takes the certificate. ${SUPERSET_HOST} must resolve
# publicly to this server's external IP. Create the shared webroot once with
# `mkdir -p /var/www/certbot`, then take a certificate with
#
#   certbot certonly --webroot -w /var/www/certbot -d ${SUPERSET_HOST}
#
# CHANGE THE PASSWORD BEFORE PUBLISHING THIS. Superset has a login of its own, which is why
# there is no auth_basic here, but the stack creates it as admin/admin in the compose start-up
# command. Publishing this vhost with that still in place puts the dashboards, and the analytics
# database behind them, one guess away:
#
#   docker compose exec superset superset fab reset-password \
#     --username admin --password '<a real one>'
#
# X-Forwarded-Proto is what stops Superset issuing http:// redirects from behind this TLS
# terminator. Superset only honours it when ENABLE_PROXY_FIX is on, so set
# SUPERSET_ENABLE_PROXY_FIX=true in .env alongside this vhost.
#
# No websocket handling here. It matters only for Superset's async query mode, which needs
# Celery and Redis that this stack does not run.

server {
    listen 80;
    listen [::]:80;
    server_name ${SUPERSET_HOST};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    # The http2 parameter here rather than the `http2 on;` directive, which needs nginx 1.25.1
    # and errors with "unknown directive" on anything older.
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${SUPERSET_HOST};

    ssl_certificate     /etc/letsencrypt/live/${SUPERSET_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SUPERSET_HOST}/privkey.pem;

    # A chart backed by a slow query outruns the 60 second default, and CSV uploads
    # and dashboard imports are larger than the 1 MB one.
    proxy_read_timeout    300s;
    proxy_send_timeout    300s;
    client_max_body_size  100m;

    location / {
        proxy_pass http://127.0.0.1:${SUPERSET_PORT};
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  443;
    }
}
