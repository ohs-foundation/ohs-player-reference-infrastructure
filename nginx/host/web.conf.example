# Host nginx vhost for the Web Portal.
#
# Generated by `./dev.sh render` from this template, so change WEB_HOST or OHS_PLAYER_WEB_PORT
# in .env and re-render rather than editing the output. This is the HOST nginx. The nginx inside
# the web image, which proxies /fhir and /api/ on to the gateway, is configured by ../spa.conf.
#
# Install by symlinking the rendered nginx/host/web.conf into /etc/nginx/sites-enabled/,
# then running `nginx -t && systemctl reload nginx`.
#
# ${WEB_HOST} must resolve publicly to this server's external IP.
#
# This vhost is plain HTTP. For TLS, create the webroot once with `mkdir -p /var/www/certbot`,
# take a certificate with
#
#   certbot certonly --webroot -w /var/www/certbot -d ${WEB_HOST}
#
# and only then add the 443 server block. Adding it first makes nginx refuse to start, because
# it cannot open certificate files that do not exist yet.
#
# Everything the SPA calls arrives here, the bundle itself and its /fhir and /api/ requests
# alike, because spa.conf inside the image forwards those two prefixes to the gateway over the
# compose network. That is what keeps them same-origin, so no CORS is involved. It also means
# VITE_FHIR_BASE_URL must name THIS host, not the gateway one:
#
#   VITE_FHIR_BASE_URL=http://${WEB_HOST}/fhir
#
# The body size ceiling matches spa.conf so a bulk import is not rejected at the edge before it
# reaches the gateway.

server {
    listen 80;
    listen [::]:80;
    server_name ${WEB_HOST};

    client_max_body_size 25m;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        proxy_pass http://127.0.0.1:${OHS_PLAYER_WEB_PORT};
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
