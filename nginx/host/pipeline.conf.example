# Host nginx vhost for the FHIR Data Pipes pipeline controller.
#
# Generated by `./dev.sh render` from this template, so change PIPELINE_HOST or PIPELINE_PORT in
# .env and re-render rather than editing the output. Rendered only when PIPELINE_HOST is set,
# because the controller belongs to the --pipes profile and most stacks never run it.
#
# `./dev.sh nginx` installs this and takes the certificate. ${PIPELINE_HOST} must resolve
# publicly to this server's external IP. Create the shared webroot once with
# `mkdir -p /var/www/certbot`, then take a certificate with
#
#   certbot certonly --webroot -w /var/www/certbot -d ${PIPELINE_HOST}
#
# READ THIS BEFORE PUBLISHING IT. The controller has no authentication of its own. Its web UI
# starts full and incremental pipeline runs and exposes the data warehouse it writes, so on a
# public name it hands all of that to anyone who finds it. The auth_basic below is therefore
# not optional decoration. Create the password file before installing this vhost:
#
#   sudo apt install apache2-utils         # or: dnf install httpd-tools
#   sudo htpasswd -c /etc/nginx/.htpasswd-pipeline ops
#
# A missing password file is not a way in. nginx answers 401 and never proxies, so the vhost
# fails closed either way. Consider not publishing this at all and reaching it over an SSH
# tunnel instead:
#
#   ssh -L 8090:127.0.0.1:8090 user@server

server {
    listen 80;
    listen [::]:80;
    server_name ${PIPELINE_HOST};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    # The http2 parameter here rather than the `http2 on;` directive, which needs nginx 1.25.1
    # and errors with "unknown directive" on anything older.
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${PIPELINE_HOST};

    ssl_certificate     /etc/letsencrypt/live/${PIPELINE_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${PIPELINE_HOST}/privkey.pem;

    # A full pipeline run over a large dataset holds the connection open well past
    # the 60 second default while it works.
    proxy_read_timeout    1800s;
    proxy_send_timeout    1800s;
    client_max_body_size  25m;

    location / {
        auth_basic           "Pipeline controller";
        auth_basic_user_file /etc/nginx/.htpasswd-pipeline;

        proxy_pass http://127.0.0.1:${PIPELINE_PORT};
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  443;
    }
}
