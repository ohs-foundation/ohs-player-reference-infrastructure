# Host nginx vhost for the FHIR Gateway.
#
# Generated by `./dev.sh render` from this template, so change GATEWAY_HOST or FHIR_GATEWAY_PORT
# in .env and re-render rather than editing the output. This is the HOST nginx. The nginx inside
# the web image is configured by ../spa.conf.
#
# Install by symlinking the rendered nginx/host/gateway.conf into /etc/nginx/sites-enabled/,
# then running `nginx -t && systemctl reload nginx`.
#
# ${GATEWAY_HOST} must resolve publicly to this server's external IP.
#
# This vhost is plain HTTP. For TLS, create the webroot once with `mkdir -p /var/www/certbot`,
# take a certificate with
#
#   certbot certonly --webroot -w /var/www/certbot -d ${GATEWAY_HOST}
#
# and only then add the 443 server block. Adding it first makes nginx refuse to start, because
# it cannot open certificate files that do not exist yet.
#
# Who this vhost is for: the Client App and any other native client, which are not bound by
# CORS, plus debugging with curl. The Web Portal does NOT need it — spa.conf inside the web
# image proxies /fhir and /api/ to the gateway over the compose network, so the browser only
# ever talks to WEB_HOST.
#
# The /api/ block below matters only if you point a BROWSER client straight at this subdomain,
# by setting VITE_FHIR_BASE_URL to this host rather than to WEB_HOST. The gateway's own
# interceptor sends CORS headers for /fhir/*, but the plugin's /api/* servlets send none, so
# they are added here and preflight is answered at the edge. Serving the SPA from WEB_HOST
# avoids all of it.

server {
    listen 80;
    listen [::]:80;
    server_name ${GATEWAY_HOST};

    client_max_body_size 25m;
    proxy_read_timeout 300s;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # /fhir/* : the gateway's own CORS interceptor already sends
    # Access-Control-Allow-Origin, so do NOT add it here — it would duplicate.
    location /fhir/ {
        proxy_pass http://127.0.0.1:${FHIR_GATEWAY_PORT};
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # /api/* : the plugin's servlets send no CORS headers of their own, so add them
    # here for the SPA origin and answer preflight (OPTIONS) at the edge.
    location /api/ {
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin  $http_origin always;
            add_header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Authorization, Content-Type, Accept" always;
            add_header Access-Control-Max-Age       3600 always;
            add_header Content-Length 0;
            add_header Content-Type   text/plain;
            return 204;
        }
        proxy_pass http://127.0.0.1:${FHIR_GATEWAY_PORT};
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Access-Control-Allow-Origin $http_origin always;
    }

    location / {
        proxy_pass http://127.0.0.1:${FHIR_GATEWAY_PORT};
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
