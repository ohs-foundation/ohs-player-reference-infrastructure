# Host nginx vhost for Keycloak.
#
# Generated by `./dev.sh render` from this template, so change KEYCLOAK_HOST or KEYCLOAK_PORT
# in .env and re-render rather than editing the output. This is the HOST nginx, the one running
# on the server itself. The nginx that fronts the whole stack on a single origin is ../ohs-player.conf,
# and the one inside the web image is ../spa.conf.
#
# Install by symlinking the rendered nginx/host/keycloak.conf into /etc/nginx/sites-enabled/,
# then running `nginx -t && systemctl reload nginx`.
#
# ${KEYCLOAK_HOST} must resolve publicly to this server's external IP.
#
# This vhost is plain HTTP. For TLS, create the webroot once with `mkdir -p /var/www/certbot`,
# take a certificate with
#
#   certbot certonly --webroot -w /var/www/certbot -d ${KEYCLOAK_HOST}
#
# and only then add the 443 server block. Adding it first makes nginx refuse to start, because
# it cannot open certificate files that do not exist yet.
#
# Keycloak builds issuer URLs and redirects from the Host header, so X-Forwarded-Proto and
# X-Forwarded-Host are not optional here. Without them it issues http:// URLs behind a TLS
# terminator and the login round trip breaks.

server {
    listen 80;
    listen [::]:80;
    server_name ${KEYCLOAK_HOST};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        proxy_pass http://127.0.0.1:${KEYCLOAK_PORT};
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
    }
}
