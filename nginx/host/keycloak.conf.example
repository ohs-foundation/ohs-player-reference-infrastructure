# Host nginx vhost for Keycloak.
#
# Generated by `./dev.sh render` from this template, so change KEYCLOAK_HOST or KEYCLOAK_PORT in
# .env and re-render rather than editing the output. This is the HOST nginx, running on the server
# itself. The nginx that fronts the whole stack on one origin is ../ohs-player.conf, and the one
# inside the web image is ../spa.conf.
#
# `./dev.sh nginx` installs this and takes the certificate. Doing it by hand means symlinking the
# rendered nginx/host/keycloak.conf into /etc/nginx/sites-enabled/ and running
# `nginx -t && systemctl reload nginx`, but only once the certificate exists — nginx refuses to
# load a vhost whose certificate files are missing.
#
# ${KEYCLOAK_HOST} must resolve publicly to this server's external IP. Create the shared webroot
# once with `mkdir -p /var/www/certbot`, then take a certificate with
#
#   certbot certonly --webroot -w /var/www/certbot -d ${KEYCLOAK_HOST}
#
# nginx must keep listening on all interfaces, not just the public one. The gateway container
# resolves ${KEYCLOAK_HOST} for OIDC discovery and calls back in on 443, so a listener bound only
# to the external address would break token validation inside the stack.

server {
    listen 80;
    listen [::]:80;
    server_name ${KEYCLOAK_HOST};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    # The http2 parameter here rather than the `http2 on;` directive, which needs nginx 1.25.1
    # and errors with "unknown directive" on anything older.
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${KEYCLOAK_HOST};

    ssl_certificate     /etc/letsencrypt/live/${KEYCLOAK_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${KEYCLOAK_HOST}/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:${KEYCLOAK_PORT};
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  443;
    }
}
