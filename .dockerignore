# Both Dockerfile and Dockerfile.web build with `context: .`, so everything not
# excluded here is uploaded to the Docker daemon on every build. Only
# nginx/spa.conf is actually COPYed from the context; the rest of the build
# clones its sources from git.

# --- Secrets and local environment -------------------------------------------
.env
.env.*
!.env.example

# --- Rendered config (regenerated by dev.sh; may contain secrets) -------------
keycloak/ohs-player-realm.json
hapi-fhir/application-auth.yaml
hapi-fhir/application-no-auth.yaml
data-pipes/config/postgres-analytics.json

# --- Version control ----------------------------------------------------------
.git/
.gitignore
.github/

# --- Pipeline working data (can grow to gigabytes) ---------------------------
data-pipes/dwh/

# --- Documentation and tooling, never needed in an image ---------------------
docs/
.superpowers/
.claude/
README.md
LICENSE
