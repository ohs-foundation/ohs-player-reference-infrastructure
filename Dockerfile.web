# syntax=docker/dockerfile:1

###############################################################################
# Build the ohs-player-web SPA from a clone of the web portal monorepo
###############################################################################
FROM node:22-alpine AS web-build
WORKDIR /repo
RUN apk add --no-cache git
# Corepack takes the pnpm version from the cloned repo's `packageManager` field, so
# pinning one here is ignored — it only downloads a pnpm that never runs. Enable
# corepack and let the repo decide.
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable

ARG WEB_REF=main
RUN git clone --depth 1 --branch "${WEB_REF}" \
    https://github.com/ohs-foundation/ohs-player-reference-web-portal.git .

# One retry: this step fetches corepack's pnpm and the whole dependency tree, and a
# transient registry timeout here fails the entire image build.
RUN pnpm install --frozen-lockfile || pnpm install --frozen-lockfile

# Browser-facing config, baked into the bundle at build time.
# VITE_FHIR_BASE_URL must be absolute and must name the SPA's own origin: the
# Portal derives its /api/* base by stripping a trailing `/fhir`, and a bare
# `/fhir` strips to nothing, leaving every custom endpoint at /fhir/api/... .
# See the note in .env.example.
ARG VITE_FHIR_BASE_URL=http://localhost:8084/fhir
ARG VITE_OIDC_ISSUER=http://keycloak.localhost:8081/realms/ohs-player
ARG VITE_CLIENT_ID=ohs-player-client
ARG VITE_FHIR_VERSION=R4
ENV VITE_FHIR_BASE_URL=$VITE_FHIR_BASE_URL \
    VITE_OIDC_ISSUER=$VITE_OIDC_ISSUER \
    VITE_CLIENT_ID=$VITE_CLIENT_ID \
    VITE_FHIR_VERSION=$VITE_FHIR_VERSION

RUN pnpm exec turbo run build --filter=ohs-player-web

###############################################################################
# Serve the static bundle
###############################################################################
FROM nginx:1.27-alpine
COPY --from=web-build /repo/apps/ohs-player-web/dist /usr/share/nginx/html
COPY nginx/spa.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
